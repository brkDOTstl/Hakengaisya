{
  "name": "hakengaisya",
  "version": "0.8.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brkDOTstl/Hakengaisya.git"
  },
  "private": true,
  "description": "Company topology templates for task orchestration",
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.ts",
    "staff": "node scripts/staff.ts",
    "staff:build": "node scripts/staff.ts build",
    "workflow": "node scripts/workflow.ts",
    "plugin:build": "node scripts/build-plugin.ts",
    "test": "node scripts/check-suite.ts",
    "test:workflow": "node --test tests/*.test.ts",
    "test:evaluator": "npm --prefix packages/evaluator test",
    "test:harness2": "python -m unittest discover -s tests/harness2 -p test_*.py -v",
    "example:harness2": "node examples/harness2/local-demo.ts",
    "audit": "node scripts/release-audit.ts",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/evaluator/tsconfig.json"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
