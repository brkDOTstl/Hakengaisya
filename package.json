{
  "name": "hakengaisya",
  "version": "0.8.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brkDOTstl/Hakengaisya.git"
  },
  "private": true,
  "description": "Company topology templates for task orchestration",
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.mjs",
    "staff": "node scripts/staff.mjs",
    "staff:build": "node scripts/staff.mjs build",
    "workflow": "node scripts/workflow.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "test": "node scripts/check-suite.mjs",
    "test:workflow": "node --test tests/*.test.mjs",
    "test:evaluator": "npm --prefix packages/evaluator test",
    "audit": "node scripts/release-audit.mjs",
    "format": "biome check --write .",
    "lint": "biome ci ."
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
